# ==============================================================================
# PROFESSIONAL APACHE CONFIGURATION (.htaccess) FOR REACT / VITE SPA & PHP
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DEFAULT INDEX & SERVER SETTINGS
# ------------------------------------------------------------------------------
DirectoryIndex index.html index.php

# Disable directory browsing for security
Options -Indexes

# Follow symbolic links (required for mod_rewrite)
Options +FollowSymLinks

# Prevent Apache from displaying server version information
ServerSignature Off

# UTF-8 default character encoding
AddDefaultCharset UTF-8

# ------------------------------------------------------------------------------
# 2. REWRITE ENGINE, HTTPS, WWW & REACT SPA ROUTING
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # --------------------------------------------------------------------------
    # 2a. FORCE HTTPS (SSL REDIRECTION)
    # --------------------------------------------------------------------------
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} ^(?:www\.)?(.*)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # --------------------------------------------------------------------------
    # 2b. REDIRECT WWW TO NON-WWW
    # --------------------------------------------------------------------------
    RewriteCond %{HTTP_HOST} ^www\.(.+) [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # --------------------------------------------------------------------------
    # 2c. PHP CLEAN URL SUPPORT (If actual .php files exist on server)
    # --------------------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^([^\.]+)$ $1.php [NC,L]

    # --------------------------------------------------------------------------
    # 2d. REACT ROUTER SINGLE PAGE APP (SPA) FALLBACK
    # Fixes 404 Not Found error on direct links & page refresh (e.g. /about, /products)
    # --------------------------------------------------------------------------
    # If the requested URL is NOT an existing file or directory, route to index.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [QSA,L]
</IfModule>

# ------------------------------------------------------------------------------
# 3. SECURITY & FILE PROTECTION
# ------------------------------------------------------------------------------
# Block access to hidden files (.env, .git, etc.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block access to sensitive configuration and log files
<FilesMatch "\.(env|example|log|ini|sh|sql|bak|config|json|md|gitignore|oxlintrc)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block HTTP TRACE & TRACK methods
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK) [NC]
    RewriteRule .* - [F]
</IfModule>

# ------------------------------------------------------------------------------
# 4. HTTP SECURITY HEADERS
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# ------------------------------------------------------------------------------
# 5. PERFORMANCE & CACHING
# ------------------------------------------------------------------------------
# Enable Gzip / Deflate Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml font/ttf font/otf font/woff font/woff2
</IfModule>

# Browser Caching (Expires Headers)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML (Keep fresh for immediate updates)
    ExpiresByType text/html "access plus 0 seconds"

    # Data & APIs
    ExpiresByType application/json "access plus 0 seconds"

    # Media & Images
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"

    # CSS & JavaScript
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"

    # Web Fonts
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>

# ------------------------------------------------------------------------------
# 6. CUSTOM ERROR PAGES (Fallback if index.html is missing)
# ------------------------------------------------------------------------------
ErrorDocument 404 /index.html
ErrorDocument 500 /index.html
