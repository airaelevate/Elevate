# ==============================================================================
# PROFESSIONAL APACHE SERVER CONFIGURATION (.htaccess)
# Designed for Production HTML & PHP Applications
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DEFAULT INDEX & SERVER SETTINGS
# ------------------------------------------------------------------------------
# Set the default index files to look for when accessing directories
DirectoryIndex index.php index.html

# Disable directory browsing for security (hides folder contents)
Options -Indexes

# Follow symbolic links (required for mod_rewrite on many Apache hosts)
Options +FollowSymLinks

# Prevent Apache from displaying server version information
ServerSignature Off

# UTF-8 encoding default
AddDefaultCharset UTF-8

# ------------------------------------------------------------------------------
# 2. REWRITE ENGINE & URL CANONICALIZATION
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # --------------------------------------------------------------------------
    # 2a. FORCE HTTPS (SSL REDIRECTION)
    # --------------------------------------------------------------------------
    # Redirect HTTP requests to secure HTTPS
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} ^(?:www\.)?(.*)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # --------------------------------------------------------------------------
    # 2b. FORCE NON-WWW (www to non-www redirection)
    # --------------------------------------------------------------------------
    # To switch to forcing www instead, swap the comments on the rules below.
    RewriteCond %{HTTP_HOST} ^www\.(.+) [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # --------------------------------------------------------------------------
    # 2c. REMOVE TRAILING SLASHES (Except Directories)
    # --------------------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # --------------------------------------------------------------------------
    # 2d. CLEAN URLS (HIDE .PHP AND .HTML EXTENSIONS)
    # --------------------------------------------------------------------------
    # Allow access to pages without typing .php extension (e.g. /about -> /about.php)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^([^\.]+)$ $1.php [NC,L]

    # Allow access to pages without typing .html extension (e.g. /contact -> /contact.html)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^([^\.]+)$ $1.html [NC,L]
</IfModule>

# ------------------------------------------------------------------------------
# 3. SECURITY & FILE ACCESS PROTECTIONS
# ------------------------------------------------------------------------------
# Block access to hidden files (files starting with a dot like .htaccess, .git, .env)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Protect sensitive environment, configuration, and log files
<FilesMatch "\.(env|example|log|ini|sh|sql|bak|config|json|md|gitignore|oxlintrc)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Disable HTTP TRACE and TRACK methods to prevent XSS/Cross-Tracing attacks
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK) [NC]
    RewriteRule .* - [F]
</IfModule>

# ------------------------------------------------------------------------------
# 4. HTTP SECURITY HEADERS
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    # Prevent MIME-type sniffing (forces browsers to respect declared Content-Type)
    Header set X-Content-Type-Options "nosniff"

    # Protect against Clickjacking by restricting framing to same origin
    Header set X-Frame-Options "SAMEORIGIN"

    # Enable browser XSS filtering
    Header set X-XSS-Protection "1; mode=block"

    # Control Referrer information sent when navigating away
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Restrict unneeded browser capabilities
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # HTTP Strict Transport Security (HSTS) - Force HTTPS for 1 year
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# ------------------------------------------------------------------------------
# 5. PERFORMANCE OPTIMIZATION & CACHING
# ------------------------------------------------------------------------------
# Enable Gzip / Deflate Compression for text assets
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# Leverage Browser Caching (Expires Headers)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML Documents (keep fresh)
    ExpiresByType text/html "access plus 1 hour"

    # Data / APIs
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType application/xml "access plus 0 seconds"

    # Media & Images (cache long-term)
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType video/webm "access plus 1 year"

    # CSS & JavaScript
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # Web Fonts
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
</IfModule>

# ------------------------------------------------------------------------------
# 6. CUSTOM ERROR PAGES
# ------------------------------------------------------------------------------
# Define custom error handling pages
ErrorDocument 400 /400.php
ErrorDocument 401 /401.php
ErrorDocument 403 /403.php
ErrorDocument 404 /404.php
ErrorDocument 500 /500.php
